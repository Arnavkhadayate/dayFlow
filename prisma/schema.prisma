generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum TaskStatus {
  INBOX
  PLANNED
  IN_PROGRESS
  COMPLETED
  DEFERRED
  CANCELLED
  SUPERSEDED
  MISSED
}
enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}
enum HabitFrequency {
  DAILY
  WEEKLY
}

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  preferences UserPreference?
  domains Domain[]
  goals Goal[]
  projects Project[]
  tasks Task[]
  habits Habit[]
}

model UserPreference {
  id String @id @default(uuid())
  userId String @unique
  timezone String @default("Asia/Kolkata")
  dailyCapacityMinutes Int @default(300)
  weekStartsOn Int @default(1)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Domain {
  id String @id @default(uuid())
  userId String
  name String
  color String @default("blue")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]
  goals Goal[]
  projects Project[]
  habits Habit[]
  @@unique([userId, name])
}

model Goal {
  id String @id @default(uuid())
  userId String
  domainId String?
  title String
  description String?
  targetDate DateTime?
  status GoalStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  milestones Milestone[]
  tasks Task[]
  projects Project[]
  @@index([userId, status])
}

model Milestone {
  id String @id @default(uuid())
  goalId String
  title String
  position Int
  completedAt DateTime?
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  @@unique([goalId, position])
}

model Project {
  id String @id @default(uuid())
  userId String
  domainId String?
  goalId String?
  name String
  description String?
  targetDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks Task[]
  @@index([userId])
}

model Task {
  id String @id @default(uuid())
  userId String
  parentTaskId String?
  domainId String?
  goalId String?
  projectId String?
  title String
  description String?
  priority TaskPriority @default(MEDIUM)
  estimatedMinutes Int?
  actualMinutes Int?
  hardDeadline DateTime?
  targetDate DateTime?
  plannedStart DateTime?
  plannedEnd DateTime?
  status TaskStatus @default(INBOX)
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentTask Task? @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks Task[] @relation("TaskChildren")
  domain Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  dependencies TaskDependency[] @relation("TaskDependencies")
  dependents TaskDependency[] @relation("TaskDependents")
  blocks TaskTimeBlock[]
  split TaskSplit?
  @@index([userId, status])
  @@index([userId, targetDate])
}

model TaskSplit {
  id String @id @default(uuid())
  parentTaskId String @unique
  requestKey String @unique
  createdAt DateTime @default(now())
  parentTask Task @relation(fields: [parentTaskId], references: [id], onDelete: Cascade)
}

model TaskDependency {
  taskId String
  dependsOnTaskId String
  task Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  @@id([taskId, dependsOnTaskId])
}

model TaskTimeBlock {
  id String @id @default(uuid())
  taskId String
  startAt DateTime
  endAt DateTime
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId, startAt])
}

model Habit {
  id String @id @default(uuid())
  userId String
  domainId String?
  name String
  frequency HabitFrequency
  targetCount Int @default(1)
  createdAt DateTime @default(now())
  archivedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  completions HabitCompletion[]
  @@index([userId, archivedAt])
}

model HabitCompletion {
  id String @id @default(uuid())
  habitId String
  completedAt DateTime @default(now())
  note String?
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  @@index([habitId, completedAt])
}
